# Kopyala:  cp .env.example .env   (Windows PowerShell:  Copy-Item .env.example .env)
# Gercek sifreleri .env dosyasinda tut; .env surum kontrolune girmez.

WP_PORT=8080
WP_HOST=localhost:8080

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=degistir-beni
DB_ROOT_PASSWORD=degistir-beni-root

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=degistir-beni-admin
WP_ADMIN_EMAIL=admin@example.test

WORDPRESS_DEBUG=0

# MCP (istege bagli): scripts/mcp-setup.sh uygulama parolasini kendisi uretir,
# burada saklanmasi gerekmez.
