{
  "name": "theme-build",
  "private": true,
  "version": "1.1.0",
  "description": "Tailwind derleyicisi: her tema kendi kaynak dosyasindan kendi CSS'ini uretir.",
  "scripts": {
    "build": "npm run build:ahsapkasa && npm run build:istanbulpaletci && npm run build:kereste && npm run build:ahsapambalaj",
    "build:ahsapkasa": "tailwindcss -i ./ahsapkasa.css -o ../wp-content/themes/ahsapkasa-theme/assets/tailwind.css --minify && node ../wp-content/themes/ahsapkasa-theme/scripts/build-css.mjs",
    "build:istanbulpaletci": "tailwindcss -i ./istanbulpaletci.css -o ../wp-content/themes/istanbulpaletci-theme/assets/tailwind.css --minify && node ../wp-content/themes/istanbulpaletci-theme/scripts/build-css.mjs",
    "watch:ahsapkasa": "tailwindcss -i ./ahsapkasa.css -o ../wp-content/themes/ahsapkasa-theme/assets/tailwind.css --watch",
    "watch:istanbulpaletci": "tailwindcss -i ./istanbulpaletci.css -o ../wp-content/themes/istanbulpaletci-theme/assets/tailwind.css --watch",
    "build:kereste": "tailwindcss -i ./kereste.css -o ../wp-content/themes/kereste-base/assets/tailwind.css --minify && node ../wp-content/themes/kereste-base/scripts/build-css.mjs",
    "watch:kereste": "tailwindcss -i ./kereste.css -o ../wp-content/themes/kereste-base/assets/tailwind.css --watch",
    "build:ahsapambalaj": "node theme-src.mjs ahsapambalaj-theme && node ../wp-content/themes/ahsapambalaj-theme/scripts/build-css.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  }
}
